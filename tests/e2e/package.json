{
  "name": "o11y-frontend-automation",
  "version": "1.0.0",
  "description": "E2E tests for O11y frontend with Playwright",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "playwright test",
    "test:staging": "O11Y_E2E_BASE_URL=https://app.us.staging.o11y.cloud playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report artifacts/html",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install",
    "install:cli": "npm install -g @playwright/cli@latest && playwright-cli install --skills",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "o11y"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.4.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-playwright": "^2.11.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  }
}
